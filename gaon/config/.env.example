# ============================================================
# GAON NEXUS v4.3 환경변수 설정 파일
# 복사 후 이름 변경: C:\gaon\.env
# ============================================================

# ── LLM API 키 (13개 순환) ───────────────────────────────────
GEMINI_API_KEY_01=
GEMINI_API_KEY_02=
GEMINI_API_KEY_03=
GEMINI_API_KEY_04=
GEMINI_API_KEY_05=
GEMINI_API_KEY_06=
GEMINI_API_KEY_07=
GEMINI_API_KEY_08=
GEMINI_API_KEY_09=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
GEMINI_API_KEY_13=

# Claude API (Tier 3 폴백)
ANTHROPIC_API_KEY=

# ── I2V 엔진 ────────────────────────────────────────────────
# fal.ai Kling AI 3.0 (3단계 폴백) — https://fal.ai/dashboard/keys
FAL_KEY=

# ── Discord 알림 ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── YouTube API ──────────────────────────────────────────────
# OAuth2 client_secret.json 경로 (브라우저 인증)
YT_CLIENT_SECRETS=C:/gaon/config/yt_client_secret.json

# ── 블로그 플랫폼 ─────────────────────────────────────────────
# 네이버 블로그 API (헤더 방식)
NAVER_BLOG_TOKEN=

# 티스토리 Open API (OAuth Bearer)
TISTORY_ACCESS_TOKEN=
TISTORY_BLOG_ID=

# ── 뉴스레터 ─────────────────────────────────────────────────
# 스티비 (국내 타겟)
STIBEE_API_KEY=
STIBEE_LIST_ID=

# Mailchimp (글로벌)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# Beehiiv (글로벌 — 무료 2,500명 API 제공)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# 발신자 이메일
REPLY_TO_EMAIL=hello@gaonix.com

# ── 쿠팡파트너스 ─────────────────────────────────────────────
# 파트너스 ID (기본값: AF7354598)
COUPANG_AF_ID=AF7354598
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── Python 경로 (pipeline_runner.py 사용) ───────────────────
GAON_PYTHON=D:/programs/python.exe

# ── 선택 설정 ────────────────────────────────────────────────
# Grok API (SuperGrok — 2단계 I2V 폴백)
GROK_API_KEY=

# Runway Gen-4 (선택적 고품질 씬)
RUNWAY_API_KEY=
